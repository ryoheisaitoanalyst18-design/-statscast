# Claude Code — personal/local settings (never commit; may contain tokens)
.claude/settings.local.json

# Secrets / credentials
.env
.env.*
*.pem
*credentials*

# Netlify local state (contains site IDs / tokens)
.netlify/

# OS / editor cruft
.DS_Store

# Python バイトコード (デプロイスクリプトが scripts/ を丸ごと git add するので必須)
__pycache__/
*.pyc

# Pipeline output not used by the frontend (loader exists but no component calls it)
data/players/batter_zones/
data/dates_2026.json

# cleanup_stale_details.py が生成するレポートファイル (ローカル実行ごとに変わる)
scripts/cleanup_report_*.txt

# YouTube アップロードの認証情報は ~/.config/statscast/ に置く (upload_youtube.py)。
# update_and_deploy.sh は scripts/ を丸ごと git add するので、万一ここに置いても公開しない
client_secret*.json
*youtube_token*.json
upload_state.json
